AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
DB_PATH=metrics.sql

# Notifier backend: "telegram" (default if unset) or "discord". Only one is needed.
NOTIFIER=telegram

# Required when NOTIFIER=telegram
TG_BOT_TOKEN=123456:AA...
TG_CHAT_ID=123456789

# Optional: use Discord instead of Telegram.
# Set NOTIFIER=discord and fill this in — the TG_* vars are then not required.
# Get the URL in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123.../abc...

# Optional: HTTP timeout in seconds for Telegram/Discord requests (must be positive, default 10)
# REQUEST_TIMEOUT=30

# Optional: seconds between each speed test + device scan cycle (default 1800 = 30 min)
# SLEEP_TIME=1800
# Optional: how many cycles between detailed AI reports with graph (default 8, i.e. ~4 hours at the default SLEEP_TIME)
# REPORT_CYCLE_COUNT=8
# Optional: sets Ollama's num_ctx per-request via extra_body, to stop a local model's
# default context window from silently truncating a long prompt + a day of history.
# No effect on cloud OpenAI. Leave unset unless using a local/self-hosted AI backend.
# AI_CONTEXT_SIZE=8192

# Optional: instant outage/degradation alerting thresholds. A reading counts as
# "bad" if it's below the download threshold OR above the ping threshold; a
# speed test failing outright counts as bad too. An alert fires once per
# episode (not every cycle) once N consecutive bad readings are seen, and
# again once the connection recovers, with how long it lasted.
# OUTAGE_DOWNLOAD_THRESHOLD_MBPS=20
# OUTAGE_PING_THRESHOLD_MS=150
# OUTAGE_CONSECUTIVE_READINGS=2

# Optional: how many days of metrics/device-scan history to keep before old rows
# are pruned (checked once per detailed-report cycle, default 90)
# RETENTION_DAYS=90

# Optional: missing-device alerting. A device counts as "reliably known" if it's
# been seen in at least this fraction of scans over the lookback window; if a
# reliably-known device then vanishes for this many consecutive checks, an
# alert fires once (and again on reappearance).
# DEVICE_MISSING_LOOKBACK_DAYS=3
# DEVICE_MISSING_RELIABILITY=0.8
# DEVICE_MISSING_CONSECUTIVE_READINGS=2

# Optional: connectivity heartbeat between full speed test cycles. A lightweight
# TCP connect (not ICMP -- avoids needing root) to HEARTBEAT_HOST:HEARTBEAT_PORT
# every HEARTBEAT_INTERVAL_SECONDS while waiting for the next cycle, so a short
# outage doesn't have to wait up to SLEEP_TIME to be noticed. Alerts once after
# HEARTBEAT_CONSECUTIVE_FAILURES failed checks in a row, and again on recovery.
# HEARTBEAT_HOST=1.1.1.1
# HEARTBEAT_PORT=443
# HEARTBEAT_INTERVAL_SECONDS=60
# HEARTBEAT_CONSECUTIVE_FAILURES=3

# Optional: a specific list of devices to watch (routers, switches, APs, NAS,
# anything with a TCP port you can probe) -- unlike the general heartbeat
# above, this checks devices YOU name, individually, on the same
# HEARTBEAT_INTERVAL_SECONDS cadence. Comma-separated "host" or "host:port"
# entries; port defaults to 80 (a typical router/AP admin UI) if omitted --
# override per-entry for devices that only answer on a different port.
# Alerts once per device after MONITORED_DEVICES_CONSECUTIVE_FAILURES failed
# checks in a row, and again when that device comes back.
# MONITORED_DEVICES=192.168.1.1,192.168.1.2:8080,nas.local:22
# MONITORED_DEVICES_CONSECUTIVE_FAILURES=2
